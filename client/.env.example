# Frontend Environment Variables Example
# Copy this file to .env.local for development
# For production on Vercel, set these in Vercel Project Settings > Environment Variables

# API Configuration
# Development: http://localhost:5000
# Production: Your deployed backend URL
VITE_API_URL=http://localhost:5000

# EmailJS Configuration for Newsletter
# Get these values from https://dashboard.emailjs.com/
# 1. Service ID - Found in EmailJS Dashboard > Email Services
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# 2. Public Key - Found in EmailJS Dashboard > Account > API Keys
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# 3. Template ID - Found in EmailJS Dashboard > Email Templates
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here

# 4. Admin Email - Your restaurant's email address (where notifications will be sent)
VITE_ADMIN_EMAIL=your_admin_email@example.com

# Optional: App Configuration
VITE_APP_NAME=Mewar Delights
VITE_APP_VERSION=1.0.0
